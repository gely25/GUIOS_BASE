# ==============================================================================
# GUIOS PRO - Plantilla de variables de entorno para desarrollo local
# Copia este archivo como .env en la raíz del proyecto y ajusta los valores.
# El archivo .env NO se sube a GitHub; solo se comparte .env.example.
# ==============================================================================

# Modo depuración (True en desarrollo, False en producción)
DJANGO_DEBUG=True

# Clave secreta de Django (en producción usa una clave aleatoria y segura)
DJANGO_SECRET_KEY=clave-secreta-de-ejemplo-para-desarrollo-local-guios-pro

# Hosts permitidos, separados por comas
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes confiables para CSRF, separados por comas
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Redirección obligatoria a HTTPS (solo en producción con SSL)
DJANGO_SECURE_SSL_REDIRECT=False

# Base de datos PostgreSQL con pgvector
DB_NAME=guios_pro_db_dev
DB_USER=postgres
DB_PASSWORD=cambia_esta_clave
DB_HOST=localhost
DB_PORT=5432

# ==============================================================================
# Reservadas para futuras historias de usuario
# ==============================================================================
# Proveedor de IA
# AI_PROVIDER_API_KEY=
# AI_MODEL=

# API bibliográfica externa
# BIBLIOGRAPHIC_API_KEY=
# BIBLIOGRAPHIC_BASE_URL=
# ==============================================================================
# GUIOS PRO - Plantilla de variables de entorno para desarrollo local
# Copia este archivo como .env en la raíz del proyecto y ajusta los valores.
# El archivo .env NO se sube a GitHub; solo se comparte .env.example.
# ==============================================================================

# Modo depuración (True en desarrollo, False en producción)
DJANGO_DEBUG=True

# Clave secreta de Django (en producción usa una clave aleatoria y segura)
DJANGO_SECRET_KEY=clave-secreta-de-ejemplo-para-desarrollo-local-guios-pro

# Hosts permitidos, separados por comas
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes confiables para CSRF, separados por comas
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Redirección obligatoria a HTTPS (solo en producción con SSL)
DJANGO_SECURE_SSL_REDIRECT=False

# Base de datos PostgreSQL con pgvector
DB_NAME=guios_pro_db_dev
DB_USER=postgres
DB_PASSWORD=cambia_esta_clave
DB_HOST=localhost
DB_PORT=5432

# ==============================================================================
# Reservadas para futuras historias de usuario
# ==============================================================================
# Proveedor de IA
# AI_PROVIDER_API_KEY=
# AI_MODEL=

# ==============================================================================
# Actualización bibliográfica (HU02) - fuente científica OpenAlex
# ==============================================================================
# Todas son opcionales. Sin API key se usa el cupo diario compartido de OpenAlex;
# una key gratuita (https://openalex.org/settings/api) da cupo propio.
# BIBLIOGRAPHIC_BASE_URL=https://api.openalex.org
# BIBLIOGRAPHIC_API_KEY=
# BIBLIOGRAPHIC_TIMEOUT=20
# BIBLIOGRAPHIC_MAX_RESULTADOS=50
# ==============================================================================
# Proveedores externos de IA para HU02 (bibliografía), HU09 y HU10
# ==============================================================================
# El manifiesto gratuito vigente es obligatorio para habilitar el enrutador.
# Use una autorización específica de las cuentas configuradas para GUIOS.
GUIOS_AI_AUTORIZACION_GRATUITA=
# GUIOS_AI_GEMINI_API_KEY=
# GUIOS_AI_GEMINI_MODEL=
# GUIOS_AI_GEMINI_OPERACIONES=bibliografia,preguntas,suficiencia,valoracion
# GUIOS_AI_COHERE_OPERACIONES=
# GUIOS_AI_GROQ_OPERACIONES=
# GUIOS_AI_CLOUDFLARE_OPERACIONES=
# GUIOS_AI_OPENROUTER_OPERACIONES=
# Opcional: GUIOS_AI_<PROVEEDOR>_UNIDAD_CUOTA identifica el cupo real compartido.
# GUIOS_AI_GROQ_API_KEY=
# GUIOS_AI_GROQ_MODEL=
GUIOS_AI_TIMEOUT=15
GUIOS_AI_COOLDOWN=60
# Sin política comprobada por unidad y perfil validado por operación, no hay admisión.
# Formato y condiciones en docs/PLAN_IMPLEMENTACION.md.
GUIOS_AI_POLITICAS_CUOTA='{}'
# Opcional: proveedor -> modelo exacto -> operaciones separadas por comas.
# Cada modelo adicional comparte la clave y unidad del proveedor.
GUIOS_AI_MODELOS_ADICIONALES='{}'
# Opcional: proveedor/modelo -> política del modelo (misma forma que la del proyecto).
GUIOS_AI_POLITICAS_MODELO='{}'
GUIOS_AI_PERFILES_OPERACION='{}'
GUIOS_AI_TRABAJADORES_LOTE=4
GUIOS_AI_ESPERA_SEGUNDOS=5
GUIOS_AI_RESERVA_SEGUNDOS=120
GUIOS_AI_REUSO_SEGUNDOS=3600
# Un modelo se habilita solo para las operaciones indicadas. Para Cohere,
# autorice explícitamente el tratamiento de datos además de la gratuidad.
# El filtrado de preguntas similares es textual. La recuperación documental principal
# sigue usando RetrievalService y pgvector, independiente de estos proveedores.

# El benchmark reutiliza las variables de Gemini y Groq de arriba.
# Variables compartidas por el benchmark y el enrutador.
# Modelos y cuentas gratuitos requieren autorización vigente.
# Por compatibilidad, el benchmark admite <PROVEEDOR>_MODEL,
# <PROVEEDOR>_API_KEY y GUIOS_AI_<PROVEEDOR>_KEY como alternativas.
# Para Cloudflare también admite CLOUDFLARE_ACCOUNT_ID.
# GUIOS_AI_COHERE_API_KEY=
# GUIOS_AI_COHERE_MODEL=
# GUIOS_AI_CLOUDFLARE_API_KEY=
# Alias cuando GUIOS_AI_CLOUDFLARE_API_KEY está vacío:
# GUIOS_AI_CLOUDFLARE_API_TOKEN=
# GUIOS_AI_CLOUDFLARE_MODEL=
# GUIOS_AI_CLOUDFLARE_ACCOUNT_ID=
# GUIOS_AI_OPENROUTER_API_KEY=
# GUIOS_AI_OPENROUTER_MODEL=
# Typhoon es exclusivo de benchmarks sintéticos. No se registra en Django.
# GUIOS_AI_TYPHOON_API_KEY=
# GUIOS_AI_TYPHOON_MODEL=typhoon-v2.5-30b-a3b-instruct

# ==============================================================================
# Docker (opcional)
# ==============================================================================
# Puerto público de la aplicación en el host. Ejemplo: WEB_PORT=8080.
WEB_PORT=8000
# DB_PORT también se usa como puerto del host para PostgreSQL en docker-compose.
# Si ese puerto está ocupado, cámbialo aquí.
# Carga automática de datos al iniciar el contenedor web (0 = no, 1 = sí).
CARGAR_CATALOGO=0
CARGAR_DATOS_DEMO=0
